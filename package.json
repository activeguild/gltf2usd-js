{
  "name": "gltf2usd-js",
  "version": "0.1.0",
  "description": "Dependency-free glTF / GLB to USDZ / USDA converter for browsers and Node.js — works with Apple AR Quick Look",
  "keywords": [
    "gltf",
    "glb",
    "usd",
    "usdz",
    "usda",
    "openusd",
    "ar-quick-look",
    "quick-look",
    "arkit",
    "realitykit",
    "3d",
    "converter",
    "webgl",
    "browser"
  ],
  "homepage": "https://github.com/activeguild/gltf2usd-js#readme",
  "bugs": {
    "url": "https://github.com/activeguild/gltf2usd-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activeguild/gltf2usd-js.git"
  },
  "license": "MIT",
  "author": "activeguild",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "glb2usd": "./cli.js"
  },
  "files": [
    "src/",
    "cli.js",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/make-glb.js && node test/run.js && node test/validation.js && node test/accessor.js && node test/color.js && node test/usdz.js && node test/edge-cases.js && node test/images.js",
    "test:types": "npx -y -p typescript@6.0.2 tsc -p test/tsconfig.json",
    "demo": "node demo/server.js",
    "test:integration": "node test/integration/run.js",
    "prepublishOnly": "npm test"
  }
}
